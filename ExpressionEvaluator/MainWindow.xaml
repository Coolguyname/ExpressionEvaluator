<Window x:Class="ExpressionEvaluator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ExpressionEvaluator.ViewModels"
        xmlns:local="clr-namespace:ExpressionEvaluator"
        mc:Ignorable="d"
        Title="Expression Evaluator Lexer Demo" Height="500" Width="500">

    <Window.DataContext>
        <vm:TokenizerViewModel />
    </Window.DataContext>
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Expression: " Margin="0,0,0,4" />
            <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Sans Serif Collection" FontSize="14"
                     Padding="6"
                     AcceptsReturn="False"/>
            <Button Content="Tokenize"
                    Command="{Binding TokenizeCommand}"
                    IsDefault="True"
                    HorizontalAlignment="Right"
                    Padding="12"
                    Margin="0,8,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Tokens}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  FontFamily="Sans Serif Collection">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="60" />
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="120"/>
                <DataGridTextColumn Header="Lexeme" Binding="{Binding Lexeme}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="Red"
                   FontWeight="Bold"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ExpressionEvaluator.ViewModels"
        xmlns:lexing="using:ExpressionEvaluator.Core.Lexing"
        x:Class="ExpressionEvaluator.MainWindow"
        x:DataType="vm:EvaluatorViewModel"
        Title="Expression Evaluator"
        Width="800" Height="600">

	<Window.DataContext>
		<vm:EvaluatorViewModel />
	</Window.DataContext>

	<Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">

		<TextBlock Grid.Row="0" Text="Expression:" Margin="0,0,0,4" />
		<TextBox Grid.Row="1"
                 Text="{Binding ExpressionText}"
                 FontFamily="Consolas,Menlo,monospace"
                 FontSize="14"
                 Padding="6"
                 Margin="0,0,0,8" />

		<TextBlock Grid.Row="2" Text="Variables (e.g. x = 5, y = 10):" Margin="0,0,0,4" />
		<Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
			<TextBox Grid.Column="0"
                     Text="{Binding VariablesText}"
                     FontFamily="Consolas,Menlo,monospace"
                     FontSize="14"
                     Padding="6" />
			<Button Grid.Column="1"
                    Content="Evaluate"
                    Command="{Binding EvaluateCommand}"
                    IsDefault="True"
                    Padding="20,8"
                    Margin="8,0,0,0"
					Background="#cc0000"
					Foreground="White"
					FontWeight="SemiBold"/>
		</Grid>

		<StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,4">
			<TextBlock Text="Result: " FontWeight="Bold" />
			<TextBlock Text="{Binding ResultText}"
					   FontFamily="Consolas,Menlo,monospace"
                       FontSize="14" />
		</StackPanel>

		<TextBlock Grid.Row="5"
                   Text="{Binding ErrorText}"
                   Foreground="IndianRed"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

		<Grid Grid.Row="6" ColumnDefinitions="*,*">
			<DataGrid Grid.Column="0"
					  ItemsSource="{Binding Tokens}"
					  AutoGenerateColumns="False"
					  IsReadOnly="True"
					  HeadersVisibility="Column"
					  GridLinesVisibility="Horizontal"
					  FontFamily="Consolas,Menlo,monospace">
				<DataGrid.Columns>
					<DataGridTextColumn Header="#" Binding="{Binding Position}" Width="60" />
					<DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="100" />
					<DataGridTextColumn Header="Lexeme" Binding="{Binding Lexeme}" Width="*" />
				</DataGrid.Columns>
			</DataGrid>

			
			<TreeView Grid.Column="1" 
					  ItemsSource="{Binding AstNodes}"
					  FontFamily="Consolas,Menlo,monospace"
					  FontSize="14"
					  Margin="8,0,0,0">

				<TreeView.Styles>
					<Style Selector="TreeViewItem">
						<Setter Property="IsExpanded" Value="True"/>
						<Setter Property="Padding" Value="4"/>
					</Style>
				</TreeView.Styles>
				
				<TreeView.ItemTemplate>
					<TreeDataTemplate ItemsSource="{Binding Children}">
						<Border Background="#F8F8F8"
								CornerRadius="4"
								BorderBrush="#E0E0E0"
								BorderThickness="1"
								Padding="6">
							<TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
						</Border>
					</TreeDataTemplate>
				</TreeView.ItemTemplate>
				
			</TreeView>
		</Grid>
		
	</Grid>
</Window>